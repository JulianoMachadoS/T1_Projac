# banco proprio da integracao (prefixo INTEGRATION_ pra nao colidir com o DB_* do i-Educar)
INTEGRATION_DB_USER=integration
INTEGRATION_DB_PASSWORD=integration
INTEGRATION_DB_NAME=integration

# nomes dos servicos na rede do docker compose (nginx = i-Educar)
IEDUCAR_URL=http://nginx
# gerar com: docker compose exec php php artisan admin:token integracao
IEDUCAR_TOKEN=

MOODLE_URL=http://moodle:8080
# gerado pelo ./dadosIniciais/configurar-moodle.sh (ja grava aqui no .env)
MOODLE_TOKEN=
